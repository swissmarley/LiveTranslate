# ─── Server-side secrets (read only by the API routes in src/app/api) ───────────
# Never prefix these with EXPO_PUBLIC_ — that would bundle them into the app.

# Supertext API key: https://www.supertext.com/en/cockpit/api (requires an API subscription)
SUPERTEXT_API_KEY=

# ElevenLabs API key: https://elevenlabs.io/app/settings/api-keys
# Needs access to: Text to Speech, Speech to Text, Voices (read). Setting a credit quota on the key is recommended.
ELEVENLABS_API_KEY=

# Optional: voice used when the app has not picked one (any voice ID from your ElevenLabs "My Voices").
ELEVENLABS_VOICE_ID=

# Shared secret the app must send (x-app-token header). Required by a deployed (production) server:
# without it every route answers 503, unless APP_ALLOW_OPEN_ACCESS=true. Not needed in development.
APP_ACCESS_TOKEN=
# Set to true only if you really want a deployed server that anyone with its URL can use.
APP_ALLOW_OPEN_ACCESS=
# Requests per minute per client and route (default 30; live-recognition tokens get a third). 0 = off.
APP_RATE_LIMIT_PER_MINUTE=
# Other websites allowed to call a deployed server from a browser, comma-separated (default: none).
APP_ALLOWED_ORIGINS=
# Which proxy may tell the server a client's IP address (for the rate limit). Clients can fake
# X-Forwarded-For, so it is only believed from a proxy you name here:
#   cloudflare             CF-Connecting-IP (default on EAS Hosting, which runs on Cloudflare)
#   x-forwarded-for:<hops> X-Forwarded-For, <hops> entries from the right (one per proxy of yours)
#   none                   believe nothing; all clients share one limit (default elsewhere)
APP_TRUSTED_PROXY=

# ─── Client-side (bundled into the app) ─────────────────────────────────────────
# URL of the deployed API server (e.g. https://live-translate.expo.app). Leave empty during development:
# the app then talks to the dev server that serves it.
EXPO_PUBLIC_API_URL=
# Must match APP_ACCESS_TOKEN when that is set.
EXPO_PUBLIC_APP_TOKEN=
